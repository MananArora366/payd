# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API Key for Voice Interpretation & Financial Q&A
GEMINI_API_KEY=your-gemini-api-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true for fully-functional standalone demo mode with pre-seeded data
PAYD_DEMO_MODE=true

# AWS Bedrock (optional; falls back to the deterministic parser when unset)
# Prefer AWS_PROFILE (e.g. via aws configure sso) over explicit keys.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5
BEDROCK_ENABLED=false
