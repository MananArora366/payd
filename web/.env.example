# Supabase Configuration
# Currently unused: Payd runs on the in-memory demo store. src/lib/supabase/* reads only the two
# NEXT_PUBLIC_ vars below, and nothing imports those helpers yet.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   (not read by any code yet)

# Google Gemini API Key for Voice Interpretation & Financial Q&A
GEMINI_API_KEY=your-gemini-api-key

# AWS Bedrock (optional; falls back to the deterministic parser when disabled)
# BEDROCK_ENABLED must be exactly 'true' to use Bedrock. AWS credentials inherited from your
# shell (AWS_PROFILE, AWS_ACCESS_KEY_ID, ...) are ignored unless it is set.
# Prefer AWS_PROFILE (e.g. via aws configure sso) over explicit keys.
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5
AWS_REGION=us-east-1
# Used when AWS_REGION is unset.
AWS_DEFAULT_REGION=
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Careem MCP server Payd targets. Defaults to the local sandbox
# (https://builders.careem.com/docs/sandbox). Production: https://mcp.careemapis.com/mcp
CAREEM_MCP_URL=http://127.0.0.1:8787/mcp

# Shared secret for POST /api/careem/webhook (sent by careem-mcp as X-Payd-Webhook-Secret).
# Must match PAYD_WEBHOOK_SECRET in careem-mcp's env. Both default to "payd-local-dev-secret";
# set your own value anywhere the app is reachable from outside your machine.
PAYD_WEBHOOK_SECRET=payd-local-dev-secret

# HMAC key that signs the ride-quote context blobs Payd's MCP tools hand out (create_ride rejects
# forged, expired or reused blobs). Unset = a random per-process key, so blobs stop working after
# a server restart. Set a long random value in production.
PAYD_MCP_SECRET=

# Endpoint the stdio MCP bridge (`npm run mcp`, scripts/mcp-server.mjs) forwards to.
# Default: http://127.0.0.1:3000/api/mcp
PAYD_MCP_URL=

# Build output folder (default .next). `npm run share` sets .next-share so it doesn't clobber `next dev`.
NEXT_DIST_DIR=
